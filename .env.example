# =============================================================================
# Harmony Physio — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# Database — PostgreSQL on AWS RDS eu-west-2
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://harmony:changeme@localhost:5432/harmony_physio?schema=public"

# ---------------------------------------------------------------------------
# NextAuth.js v5
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET="replace-with-32-char-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Daily.co — Video consultations
# Get from: https://dashboard.daily.co/developers
# ---------------------------------------------------------------------------
DAILY_CO_API_KEY="your-daily-co-api-key"

# ---------------------------------------------------------------------------
# Stripe — Payments (amounts in pence / minor currency units)
# Test keys: https://dashboard.stripe.com/test/apikeys
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---------------------------------------------------------------------------
# Cloudflare R2 — Object storage for EHR attachments and session recordings
# R2 is S3-compatible (use @aws-sdk/client-s3 with custom endpoint)
# Get credentials from: https://dash.cloudflare.com/ → R2 → Manage API Tokens
# Note: R2 stores data in Cloudflare's global network; ensure data residency
# requirements (NHS DTAC / GDPR) are met via jurisdiction setting in R2 dashboard
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="harmony-physio-documents"
# Endpoint pattern: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
# Optional: Custom domain for public bucket access (set in R2 dashboard)
# R2_PUBLIC_URL="https://assets.harmony-physio.com"
